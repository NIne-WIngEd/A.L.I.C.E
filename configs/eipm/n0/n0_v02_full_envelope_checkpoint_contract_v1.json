{
  "schema": "alice.eipm.n0.full-envelope-checkpoint-contract.v1",
  "status": "PRECOMMITTED_SUCCESSOR_CHECKPOINT_PROVENANCE",
  "date": "2026-09-22",
  "registered_system": "N0FullEnvelopeTrainableSystemV1",
  "registered_topology": "configs/eipm/n0/n0_v02_full_envelope_registered_topology_v1.json",
  "trainer": "scripts/eipm/n0/train_n0_v02_full_envelope_joint_v1.py",
  "required_lineage": [
    "source_revision",
    "registered_topology_sha256",
    "semantic_initialization_sha256",
    "full_public_mixture_manifest_sha256",
    "full_public_mixture_audit_sha256",
    "stage",
    "stage_policy",
    "optimizer_contract",
    "scheduler_contract",
    "objective_contract",
    "tokenizer_sha256",
    "public_corpus_receipt_sha256",
    "teacher_audit_sha256",
    "static_proof_receipt_sha256",
    "operator_evidence_token_receipt_sha256",
    "accelerator_state_tree_sha256",
    "full_system_sha256",
    "objective_state_sha256"
  ],
  "state_artifacts": {
    "full_system": "full_system.safetensors",
    "objective_state": "full_envelope_objective.safetensors",
    "accelerator_state": "accelerator_state/",
    "receipt": "receipt.json",
    "all_hashes_required": true
  },
  "stage_policy": {
    "stages": [
      "J1_joint_semantic_operator",
      "J2_reopened_representation_interfaces",
      "J3_full_public_n0_coadaptation"
    ],
    "one_full_instantiated_topology_every_stage": true,
    "stage_transition_requires_dev_evidence": true,
    "automatic_stage_transition": false,
    "optimizer_parameter_groups_keep_full_topology_stable": true,
    "frozen_parameters_remain_in_optimizer_groups_without_updates": true,
    "no_historical_model_constructor_authority": true,
    "exact_head_static_proof_receipt_required": true
  },
  "optimizer_contract": {
    "name": "AdamW",
    "pretrained_semantic_backbone_lr": 0.00001,
    "new_or_reopened_interfaces_lr": 0.00005,
    "backbone_weight_decay": 0.1,
    "interface_weight_decay": 0.05,
    "norm_and_bias_weight_decay": 0,
    "gradient_clip_norm": 1,
    "macro_family_ema_updated_once_per_effective_batch": true,
    "family_ema_reduced_across_all_distributed_ranks": true
  },
  "scheduler_contract": {
    "family": "linear_warmup_cosine_decay",
    "horizon_is_runtime_operating_point_not_stage_completion": true,
    "fixed_total_steps_as_capability_definition": false,
    "stage_completion_requires_dev_gate_not_step_budget": true
  },
  "authority": {
    "private_identity_data": false,
    "private_identity_gradient": false,
    "final_results_observed": false,
    "final_checkpoint_selection_allowed": false,
    "final_opening_authorized": false,
    "checkpoint_receipt_is_n0_completion": false
  }
}
