    "latent_recoverability_uses_labeled_relevance_not_availability": true,
    "step_conditioned_relation_schema_execution": true,
    "program_averaged_relation_state_role": "whole-program support geometry only; not executable per-step edge meaning",
    "graph_view_activity_requires_supported_relation_mass": true,
    "program_relation_state_aggregation": "survival-weighted relation assignment probability",
    "bidirectional_query_schema_token_evidence": true,
    "inactive_candidate_token_evidence_zeroed": true,
