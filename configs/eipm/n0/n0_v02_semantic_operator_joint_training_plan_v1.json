  "optimization_strategy": {
    "stages": [
      {
        "name": "J1_joint_semantic_operator",
        "role": "co-adapt all semantic backbone layers with the shared runtime-schema operator while preserving broad public semantic/judgment replay through existing semantic replay heads; the downstream latent judgment probe is not activated before the full fabric exists",
        "trainable": [
          "semantic_backbone_all_layers",
          "semantic_existing_heads_for_replay",
          "schema_conditioned_semantic_operator",
          "long_context_segment_bridge"
        ],
        "permanently_frozen": [],
        "downstream_modules_updated": false,
        "architecture_reduced": false
      },
      {
        "name": "J2_reopened_representation_interfaces",
        "role": "adapt structured/evidence semantic interfaces against the same foundation without freezing semantic/operator learning",
        "trainable": [
          "semantic_backbone_all_layers",
          "schema_conditioned_semantic_operator",
          "structured_successor_interface",
          "evidence_successor_interface",
          "dynamic_relation_graph_semantic_interface",
          "long_context_segment_bridge"
        ],
        "permanently_frozen": [],
        "architecture_reduced": false
      },
      {
        "name": "J3_full_public_n0_coadaptation",
        "role": "co-adapt all reopened public N0 representation modules end-to-end while preserving structural invariants and delayed Binder sparsity",
        "trainable": [
          "semantic_backbone_all_layers",
          "schema_conditioned_semantic_operator",
          "structured_successor",
          "evidence_successor",
          "dynamic_evidence_graph",
          "production_executor_successor",
          "binder_successor",
          "public_judgment_probe",
          "dynamic_fusion_successor",
          "dynamic_latent_successor",
          "long_context_segment_bridge"
        ],
        "permanently_frozen": [],
        "architecture_reduced": false
      }
    ],
    "temporary_freeze_allowed_only_for_causal_debug": true,
    "full_stack_cogradient_required_before_final_selection": true,
    "optimizer_name": "AdamW",
    "optimizer_parameter_groups": {
      "pretrained_semantic_backbone": {
        "learning_rate": 0.00001,
        "weight_decay": 0.1
      },
      "new_or_reopened_interfaces": {
        "learning_rate": 0.00005,
        "weight_decay": 0.05
      },
      "norm_and_bias": {
        "weight_decay": 0
      }
    },
    "gradient_clip_norm": 1,
    "precision": "fp16_on_p100_or_successor_mixed_precision",
    "gradient_checkpointing": true,
    "scheduler": "linear_warmup_cosine_decay",
    "warmup_fraction": 0.05,
    "fixed_total_steps": null,
    "stop_rule": "continue until precommitted DEV capability saturates without broad-semantic regression; do not stop merely because an arbitrary step budget expires",
    "checkpoint_selection": "first checkpoint satisfying every active stage gate with no regression; otherwise keep failure evidence",
    "automatic_hyperparameter_search": false,
    "automatic_rerun": false,
    "loss_family_ema_policy": {
      "update_timing": "once_per_effective_batch_after_microbatch_raw_family_aggregation",
      "differentiable_microbatches_use_update_ema": false,
      "sample_weighted_effective_batch_observation_required": true,
      "microbatch_partition_may_not_change_family_scales_within_optimizer_step": true,
      "test_or_final_results_may_not_update_scales": true
    }
  },
  "loss_balancing": {
    "method": "macro_family_balanced_with_per_objective_scale_normalization",
    "principle": "normalize heterogeneous losses to comparable running scale, average within capability family, then weight capability families rather than raw row counts",
