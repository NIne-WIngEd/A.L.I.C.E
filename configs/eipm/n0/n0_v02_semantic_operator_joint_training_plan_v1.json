  "optimization_strategy": {
    "stages": [
      {
        "name": "J1_joint_semantic_operator",
        "role": "co-adapt all semantic backbone layers with the shared runtime-schema operator while preserving broad public semantic/judgment replay through existing semantic replay heads; the downstream latent judgment probe is not activated before the full fabric exists",
        "trainable": [
          "semantic_backbone_all_layers",
          "semantic_existing_heads_for_replay",
          "schema_conditioned_semantic_operator",
          "long_context_segment_bridge"
        ],
        "permanently_frozen": [],
        "downstream_modules_updated": false,
        "architecture_reduced": false,
        "active_macro_families": [
          "broad_semantic_replay",
          "governed_judgment_replay",
          "relation_program_semantics",
          "dynamic_factor_semantics",
          "uncertainty_and_control",
          "token_evidence_grounding",
          "natural_relation_semantics"
        ],
        "inactive_macro_families": [
          "structural_support_and_roles",
          "multi_view_causal_preservation",
          "latent_judgment_and_noncollapse"
        ],
        "stage_freeze_role": "Only stage-owned modules update. Full successor topology remains instantiated; inactive downstream loss families are not evaluated through random frozen modules."
      },
      {
        "name": "J2_reopened_representation_interfaces",
        "role": "adapt structured/evidence semantic interfaces against the same foundation without freezing semantic/operator learning",
        "trainable": [
          "semantic_backbone_all_layers",
          "schema_conditioned_semantic_operator",
          "structured_successor_interface",
          "dynamic_relation_graph_semantic_interface",
          "long_context_segment_bridge",
          "production_executor_successor",
          "binder_successor"
        ],
        "permanently_frozen": [],
        "architecture_reduced": false,
        "active_macro_families": [
          "broad_semantic_replay",
          "governed_judgment_replay",
          "relation_program_semantics",
          "dynamic_factor_semantics",
          "uncertainty_and_control",
          "token_evidence_grounding",
          "natural_relation_semantics",
          "structural_support_and_roles"
        ],
        "inactive_macro_families": [
          "multi_view_causal_preservation",
          "latent_judgment_and_noncollapse"
        ],
        "stage_freeze_role": "Binder and Executor co-adapt with structured/evidence/graph interfaces so structural-support and endpoint-role losses never optimize through a random frozen arbiter. Fusion, latent, and public-judgment modules remain instantiated but inactive until J3."
      },
      {
        "name": "J3_full_public_n0_coadaptation",
        "role": "co-adapt all reopened public N0 representation modules end-to-end while preserving structural invariants and delayed Binder sparsity",
        "trainable": [
          "semantic_backbone_all_layers",
          "schema_conditioned_semantic_operator",
          "structured_successor",
          "evidence_successor",
          "dynamic_evidence_graph",
          "production_executor_successor",
          "binder_successor",
          "public_judgment_probe",
          "dynamic_fusion_successor",
          "dynamic_latent_successor",
          "long_context_segment_bridge",
          "raw_semantic_view_layer_gate",
          "semantic_input_summary_layer_gate"
        ],
        "permanently_frozen": [],
        "architecture_reduced": false,
        "active_macro_families": [
          "broad_semantic_replay",
          "governed_judgment_replay",
          "relation_program_semantics",
          "dynamic_factor_semantics",
          "uncertainty_and_control",
          "token_evidence_grounding",
          "structural_support_and_roles",
          "multi_view_causal_preservation",
          "latent_judgment_and_noncollapse",
          "natural_relation_semantics"
        ],
        "inactive_macro_families": [],
        "stage_freeze_role": "All public N0 successor capability families are active and all reopened public successor modules co-adapt end-to-end."
      }
    ],
    "temporary_freeze_allowed_only_for_causal_debug": false,
    "full_stack_cogradient_required_before_final_selection": true,
    "optimizer_name": "AdamW",
    "optimizer_parameter_groups": {
      "pretrained_semantic_backbone": {
        "learning_rate": 0.00001,
        "weight_decay": 0.1
      },
      "new_or_reopened_interfaces": {
        "learning_rate": 0.00005,
        "weight_decay": 0.05
      },
      "norm_and_bias": {
        "weight_decay": 0
      }
    },
    "gradient_clip_norm": 1,
    "precision": "fp16_on_p100_or_successor_mixed_precision",
    "gradient_checkpointing": true,
    "scheduler": "linear_warmup_cosine_decay",
    "warmup_fraction": 0.05,
    "fixed_total_steps": null,
    "stop_rule": "continue until precommitted DEV capability saturates without broad-semantic regression; do not stop merely because an arbitrary step budget expires",
    "checkpoint_selection": "first checkpoint satisfying every active stage gate with no regression; otherwise keep failure evidence",
    "automatic_hyperparameter_search": false,
    "automatic_rerun": false,
    "loss_family_ema_policy": {
      "update_timing": "once_per_effective_batch_after_microbatch_raw_family_aggregation",
      "differentiable_microbatches_use_update_ema": false,
      "sample_weighted_effective_batch_observation_required": true,
      "microbatch_partition_may_not_change_family_scales_within_optimizer_step": true,
      "test_or_final_results_may_not_update_scales": true
    },
    "stage_family_policy": {
      "family_activation_is_precommitted_before_results": true,
      "inactive_family_loss_computed": false,
      "inactive_modules_removed_from_topology": false,
      "inactive_modules_receive_optimizer_updates": false,
      "newly_activated_family_owners_train_together": true,
      "stage_freeze_is_planned_optimization_not_architecture_reduction": true,
      "ad_hoc_freeze_outside_stage_policy_allowed_only_for_causal_debug": true,
      "all_ten_families_required_in_J3_before_final_selection": true,
      "reason": "Avoid meaningless gradients through randomly initialized frozen downstream arbiters while preserving one full instantiated topology and progressively activating causally complete owner modules.",
      "J2_excludes_evidence_view_reason": "The evidence-specialist view feeds fusion rather than Binder/Executor structural losses, so it activates with the fusion/latent causal families in J3 instead of receiving no-signal or random-downstream gradients in J2."
    },
    "freeze_policy": {
      "planned_stage_inactivity_allowed": true,
      "ad_hoc_freeze_allowed_only_for_causal_debug": true,
      "permanent_parent_freeze_forbidden": true,
      "full_topology_instantiated_every_stage": true
    },
    "module_bindings": {
      "semantic_backbone_all_layers": "semantic_model.backbone",
      "semantic_existing_heads_for_replay": "semantic_model parameters excluding semantic_model.backbone",
      "schema_conditioned_semantic_operator": "stack.semantic_operator",
      "long_context_segment_bridge": "semantic_input.segment_bridge",
