        "recency_modifier",
        "temporal_constraint_modifier",
        "provenance_constraint_modifier"
      ],
      "role_semantics": "requested endpoint/readout intent over the relational program; per-edge orientation is owned by direction",
      "traversal_semantics": "whole-program LOCAL/PATH/AGGREGATE geometry represented as a continuous mixture; relation slots execute inside that geometry",
      "control_semantics": "whole-program fallback/relational/defer routing; per-slot continuation, stop and unknown are owned by event state",
      "semantic_recurrent_step_context_may_include_all_runtime_factor_banks": true,
      "copied_program_global_step_targets_are_consistency_context_only": true,
      "scope_is_not_a_capability_ceiling": "reopen with a versioned interface if observed full-envelope evidence requires a genuinely step-varying role, traversal or control primitive"
