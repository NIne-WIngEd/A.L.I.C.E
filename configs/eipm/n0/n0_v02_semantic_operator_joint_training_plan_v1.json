      "evidence_successor": "stack.evidence_view",
      "raw_semantic_view_layer_gate": "stack.raw_semantic_layer_gate",
      "dynamic_fusion_successor": "stack.fusion",
      "dynamic_latent_successor": "stack.latent",
      "public_judgment_probe": "stack.public_judgment_probe"
