{
  "schema_version": 1,
  "policy_version": "1.1.0",
  "policy_id": "friday.production_governance.v1",
  "authority": "docs/FRIDAY_PRODUCTION_GOVERNANCE.md",
  "capability_ceiling": false,
  "candidate_work": {
    "maintenance_allowed": true,
    "product_experience_research_allowed": true,
    "upstream_proposal_research_allowed": true,
    "eligible_capability_productization_allowed": true,
    "independent_research_allowed": false,
    "independent_design_allowed": false,
    "independent_implementation_allowed": false,
    "independent_testing_allowed": false,
    "new_capability_implementation_as_friday_capability_allowed": false,
    "new_capability_testing_as_friday_capability_allowed": false,
    "unilateral_production_promotion_allowed": false
  },
  "production_promotion": {
    "alice_audit_required": true,
    "rayan_approval_required": true,
    "exact_commit_binding": true,
    "exact_artifact_binding": true,
    "matching_candidate_required": true,
    "bypass_allowed": false,
    "either_may_veto": true,
    "only_rayan_may_amend_rule": true
  },
  "alice_determinations": [
    "APPROVED_FOR_RAYAN_REVIEW",
    "APPROVED_WITH_CONDITIONS",
    "RETURN_FOR_REVISION",
    "BLOCKED_SECURITY",
    "BLOCKED_PRIVACY",
    "BLOCKED_AUTHORITY",
    "BLOCKED_EVALUATION",
    "BLOCKED_ARCHITECTURE",
    "INSUFFICIENT_EVIDENCE"
  ],
  "rayan_decisions": [
    "APPROVED",
    "APPROVED_CANARY_ONLY",
    "APPROVED_CLOSED_ALPHA",
    "APPROVED_WITH_CONDITIONS",
    "REJECTED",
    "REVISION_REQUIRED",
    "DEFERRED"
  ],
  "emergency_response": {
    "rollback_allowed": true,
    "disable_allowed": true,
    "containment_allowed": true,
    "reversion_to_previously_approved_behavior_allowed": true,
    "new_capability_allowed": false,
    "broader_permissions_allowed": false,
    "new_data_collection_allowed": false,
    "unapproved_replacement_behavior_allowed": false,
    "incident_record_required": true
  },
  "required_bindings": [
    "source_commit",
    "kernel_version",
    "dependency_lock_digest",
    "artifact_hashes",
    "model_pack_versions",
    "schema_versions",
    "policy_versions",
    "migration_manifest",
    "evaluation_bundle_digest",
    "deployment_manifest",
    "rollback_manifest",
    "release_channel"
  ],
  "owner_ratified_flagship_amendment": {
    "authority": "docs/ALICE_FRIDAY_FLAGSHIP_GOVERNANCE.md",
    "effective_immediately": true,
    "supersedes_candidate_work_for_new_capabilities": true,
    "legacy_candidate_work_fields_retained_for_compatibility_only": true,
    "pre_handover_new_capability_research_as_friday_capability_allowed": false,
    "pre_handover_new_capability_implementation_allowed": false,
    "pre_handover_new_capability_testing_allowed": false,
    "post_handover_independent_maintenance_allowed": true,
    "post_handover_eligible_capability_productization_allowed": true,
    "post_handover_new_capability_dual_permission_required": true,
    "friday_originated_capability_routes_upstream": true,
    "alice_must_gain_capability_before_friday_eligibility": true,
    "rayan_owner_override_allowed": true,
    "owner_override_schema": "policies/rayan_owner_override_schema.json",
    "legacy_candidate_work_fields_are_deny_by_default": true,
    "post_handover_upstream_proposal_research_allowed": true,
    "uneligible_capability_implementation_or_testing_allowed": false
  }
}
