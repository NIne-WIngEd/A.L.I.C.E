  "boundaries": {
    "raw_source_persistence_allowed": false,
    "raw_support_persistence_allowed": false,
    "conversation_runtime_registration_allowed": false,
    "memory_write_allowed": false,
    "external_action_allowed": false,
    "model_claim_generation_allowed": false,
    "semantic_entailment_inference_allowed": false
  }
