{
  "policy_name": "alice_information_conversation_bridge_policy",
  "version": "1.0.0",
  "phase": "4",
  "milestone": "P4.5b",
  "status": "deterministic_phase3_grounding_projection",
  "source_kind": "web_source",
  "state_reference_kind": "grounding_packet",
  "outcome_mapping": {
    "answerable": "answerable",
    "conflict": "conflict",
