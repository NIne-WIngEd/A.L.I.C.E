{
  "policy_name": "alice_information_research_evidence_policy",
  "version": "1.0.0",
  "phase": "4",
  "milestone": "P4.6b",
  "status": "controlled_research_evidence_pipeline",
  "permission_id": "web.search",
  "allowed_research_input_outcomes": ["completed", "partial"],
