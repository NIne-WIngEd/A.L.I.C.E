  "injection_inspection_required": true,
  "freshness_assessment_required": true,
  "grounding_revalidation_required": true,
  "partial_research_preserved": true,
  "rejected_source_metadata_preserved": true,
  "raw_source_logging_allowed": false,
  "source_body_persistence_allowed": false,
  "live_provider_registration_allowed": false,
  "phase3_runtime_registration_allowed": false,
  "memory_write_allowed": false,
  "phase5_storage_runtime_allowed": false,
  "external_action_allowed": false,
  "background_execution_allowed": false,
  "model_claim_generation_allowed": false,
  "semantic_entailment_inference_allowed": false
}
