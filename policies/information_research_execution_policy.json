{
  "policy_name": "alice_information_research_execution_policy",
  "version": "1.0.0",
  "phase": "4",
  "milestone": "P4.7b",
  "status": "governed_research_execution",
  "permission_id": "web.search",
  "allowed_modes": ["local_only", "research"],
