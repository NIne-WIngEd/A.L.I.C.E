{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alice.local/schemas/rayan-owner-override-v1.json",
  "title": "Rayan exact-scope product-family owner override",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "override_id",
    "decision_owner",
    "capability_id",
    "reason",
    "risk_disposition",
    "waived_requirements",
    "effective_scope",
    "issued_at",
    "non_precedential"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "override_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_owner": {
      "const": "MK Rayan"
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "risk_disposition": {
      "type": "string",
      "minLength": 1
    },
    "waived_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effective_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id",
        "commit_sha",
        "artifact_hashes_digest"
      ],
      "properties": {
        "product_id": {
          "const": "friday"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_hashes_digest": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "release_channel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "non_precedential": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
